APP_NAME="DhakaWala ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
# Design preview routes (/preview/*) are disabled unless this is true.
# Never enable this on an environment that holds real firm data.
ERP_DEMO_MODE=false
APP_URL=https://erp.dhakawala.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_database
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=dhakawala_erp_

MAIL_MAILER=smtp
# Point this at your real SMTP relay (cPanel/cPanel-mail/Postmark/SES).
# 127.0.0.1 only works if a local MTA is installed on the same server.
MAIL_HOST=mail.dhakawala.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@dhakawala.com"
MAIL_FROM_NAME="${APP_NAME}"

# DhakaWala Initial Super Admin Seeder Credentials
PLATFORM_ADMIN_PRIMARY_NAME="Sohan Hossain"
PLATFORM_ADMIN_PRIMARY_EMAIL="infobd.sohan@gmail.com"
PLATFORM_ADMIN_SECONDARY_NAME="DhakaWala Platform Admin"
PLATFORM_ADMIN_SECONDARY_EMAIL="admin@dhakawala.com"
PLATFORM_ADMIN_PASSWORD="password"
